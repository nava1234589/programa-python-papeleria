def INVENTARIO():
    limpiar_contenido()
    marco_contenido.configure(bg="#F3E8FF")
    crear_titulo(marco_contenido, "INVENTARIOS")

    formulario = tk.Frame(marco_contenido, bg="#F3E8FF")
    formulario.pack(fill="x", padx=30, pady=10)

    etiquetas = [
        ("Código", "codigo"),
        ("Producto", "nombre"),
        ("Precio", "precio"),
        ("Stock", "stock")
    ]

    cajas = {}

    for i, (texto, clave) in enumerate(etiquetas):
        tk.Label(
            formulario,
            text=texto,
            bg="#F3E8FF",
            fg="#512B81",
            font=("Arial", 10, "bold")
        ).grid(row=0, column=i*2, padx=8, pady=10)

        caja = tk.Entry(formulario, width=18)
        caja.grid(row=0, column=i*2+1, padx=8, pady=10)
        cajas[clave] = caja

    # TABLA DE INVENTARIO

    tabla = ttk.Treeview(
        marco_contenido,
        columns=("codigo", "nombre", "precio", "stock"),
        show="headings",
        height=13
    )

    encabezados = [
        ("codigo", "CÓDIGO", 100),
        ("nombre", "PRODUCTO", 300),
        ("precio", "PRECIO", 150),
        ("stock", "STOCK", 150)
    ]

    for columna, titulo, ancho in encabezados:
        tabla.heading(columna, text=titulo)
        tabla.column(columna, width=ancho, anchor="center")

    tabla.pack(fill="x", padx=30, pady=15)

    # LIMPIAR CAMPOS

    def limpiar():
        for caja in cajas.values():
            caja.delete(0, tk.END)

    # MOSTRAR INVENTARIO

    def cargar_inventario():
        tabla.delete(*tabla.get_children())

        filas = ejecutar_consulta(
            """
            SELECT PRO_CODIGO, PRO_PRODUC, PRO_PRECIO, PRO_STOCK
            FROM existencias
            ORDER BY PRO_CODIGO
            """,
            obtener=True
        )

        if filas is not None:
            for fila in filas:
                tabla.insert("", tk.END, values=fila)

    # SELECCIONAR PRODUCTO

    def seleccionar_fila(event=None):
        seleccion = tabla.selection()

        if not seleccion:
            return

        valores = tabla.item(seleccion[0], "values")

        for clave, valor in zip(
            ["codigo", "nombre", "precio", "stock"],
            valores
        ):
            cajas[clave].delete(0, tk.END)
            cajas[clave].insert(0, str(valor))

    # INSERTAR PRODUCTO

    def insertar():
        nombre = cajas["nombre"].get().strip()
        precio = cajas["precio"].get().strip()
        stock = cajas["stock"].get().strip()

        if not nombre or not precio or not stock:
            messagebox.showwarning(
                "Aviso",
                "Completa todos los campos."
            )
            return

        try:
            precio = float(precio)
            stock = int(stock)

            if precio < 0 or stock < 0:
                raise ValueError

        except ValueError:
            messagebox.showwarning(
                "Aviso",
                "Precio o stock inválido."
            )
            return

        resultado = ejecutar_consulta(
            """
            INSERT INTO existencias
            (PRO_PRODUC, PRO_PRECIO, PRO_STOCK)
            VALUES (%s, %s, %s)
            """,
            (nombre, precio, stock)
        )

        if resultado is not None:
            messagebox.showinfo(
                "Éxito",
                "Producto agregado correctamente."
            )
            limpiar()
            cargar_inventario()

    # BUSCAR PRODUCTO

    def buscar():
        codigo = cajas["codigo"].get().strip()

        if not codigo.isdigit():
            messagebox.showwarning(
                "Aviso",
                "Ingresa un código válido."
            )
            return

        filas = ejecutar_consulta(
            """
            SELECT pro_codigo, pro_nombre, pro_precio, pro_stock
            FROM existencias
            WHERE pro_codigo=%s
            """,
            (int(codigo),),
            obtener=True
        )

        tabla.delete(*tabla.get_children())

        if filas is not None:
            for fila in filas:
                tabla.insert("", tk.END, values=fila)

            if filas:
                seleccionar_valores(filas[0])
            else:
                messagebox.showinfo(
                    "Aviso",
                    "Producto no encontrado."
                )

    # CARGAR DATOS EN LOS CAMPOS

    def seleccionar_valores(valores):
        for clave, valor in zip(
            ["codigo", "nombre", "precio", "stock"],
            valores
        ):
            cajas[clave].delete(0, tk.END)
            cajas[clave].insert(0, str(valor))

    # ACTUALIZAR PRODUCTO

    def actualizar():
        codigo = cajas["codigo"].get().strip()
        nombre = cajas["nombre"].get().strip()
        precio = cajas["precio"].get().strip()
        stock = cajas["stock"].get().strip()

        if not codigo.isdigit() or not nombre or not precio or not stock:
            messagebox.showwarning(
                "Aviso",
                "Completa todos los campos."
            )
            return

        try:
            precio = float(precio)
            stock = int(stock)

            if precio < 0 or stock < 0:
                raise ValueError

        except ValueError:
            messagebox.showwarning(
                "Aviso",
                "Precio o stock inválido."
            )
            return

        resultado = ejecutar_consulta(
            """
            UPDATE existencias
            SET pro_nombre=%s,
                pro_precio=%s,
                pro_stock=%s
            WHERE pro_codigo=%s
            """,
            (nombre, precio, stock, int(codigo))
        )

        if resultado is not None:
            messagebox.showinfo(
                "Éxito",
                "Inventario actualizado."
            )
            limpiar()
            cargar_inventario()

    # ELIMINAR PRODUCTO

    def eliminar():
        codigo = cajas["codigo"].get().strip()

        if not codigo.isdigit():
            messagebox.showwarning(
                "Aviso",
                "Ingresa un código válido."
            )
            return

        confirmar = messagebox.askyesno(
            "Confirmar",
            "¿Deseas eliminar este producto?"
        )

        if not confirmar:
            return

        resultado = ejecutar_consulta(
            "DELETE FROM existencias WHERE pro_codigo=%s",
            (int(codigo),)
        )

        if resultado is not None:
            messagebox.showinfo(
                "Éxito",
                "Producto eliminado."
            )
            limpiar()
            cargar_inventario()
    def generar_excel():
        # Obtener los nombres de las columnas
        columnas = tabla["columns"]
        # Obtener los registros del Treeview
        datos = [tabla.item(fila)["values"] for fila in tabla.get_children()]
        # Verificar si existen datos
        if not datos:
            messagebox.showwarning("Aviso", "No hay datos para generar el reporte")
            return
        # Organizar la información
        df = pd.DataFrame(datos, columns=columnas)
        # Crear el archivo Excel
        df.to_excel("reporte_inventario.xlsx", index=False)
        # Abrir el archivo
        os.startfile("reporte_inventario.xlsx")
        
    # SELECCIONAR FILA DE LA TABLA

    tabla.bind("<<TreeviewSelect>>", seleccionar_fila)

    # BOTONES

    botones = tk.Frame(
        marco_contenido,
        bg="#F3E8FF"
    )
    botones.pack(pady=10)

    acciones = [
        ("Mostrar", cargar_inventario),
        ("Insertar", insertar),
        ("Buscar", buscar),
        ("Actualizar", actualizar),
        ("Eliminar", eliminar),
        ("Limpiar", limpiar),
        ("generar excel",generar_excel)
    ]

    for texto, funcion in acciones:
        tk.Button(
            botones,
            text=texto,
            width=13,
            command=funcion,
            bg="#674188",
            fg="white",
            font=("Arial", 9, "bold")
        ).pack(side="left", padx=5)

    cargar_inventario()
