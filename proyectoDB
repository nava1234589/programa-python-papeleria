    marco_total.pack(fill="x", padx=30, pady=5)

    tk.Label(
        marco_total,
        text="TOTAL DE VENTAS:",
        font=("Arial", 16, "bold"),
        bg="#E2CFEA",
        fg="#512B81"
    ).pack(side="left", padx=20, pady=12)

    etiqueta_total = tk.Label(
        marco_total,
        text="$0.00",
        font=("Arial", 20, "bold"),
        bg="#E2CFEA",
        fg="#512B81"
    )
    etiqueta_total.pack(side="left", padx=10)

    # TABLA DE HISTORIAL

    tabla = ttk.Treeview(
        marco_contenido,
        columns=("id", "codigo", "nombre", "precio",
                 "cantidad", "total", "fecha"),
        show="headings",
        height=11
    )

    for columna, titulo, ancho in [
        ("id", "VENTA", 65),
        ("codigo", "CÓDIGO", 80),
        ("nombre", "PRODUCTO", 180),
        ("precio", "PRECIO", 100),
        ("cantidad", "CANTIDAD", 90),
        ("total", "TOTAL", 110),
        ("fecha", "FECHA", 170)
    ]:
        tabla.heading(columna, text=titulo)
        tabla.column(columna, width=ancho, anchor="center")

    tabla.pack(fill="x", padx=30, pady=15)

    def limpiar():
        for clave, caja in cajas.items():
            caja.delete(0, tk.END)
            if clave == "cantidad":
                caja.insert(0, "1")

    def cargar_ventas():
        tabla.delete(*tabla.get_children())

        filas = ejecutar_consulta(
            """
            SELECT venta_id, pro_codigo, pro_nombre,
                   pro_precio, pro_cantidad, pro_total, fecha
            FROM ventas
            ORDER BY venta_id DESC
            """,
            obtener=True
        )

        if filas is not None:
            for fila in filas:
                tabla.insert("", tk.END, values=fila)

    def calcular_total():
        filas = ejecutar_consulta(
            "SELECT COALESCE(SUM(pro_total), 0) FROM ventas",
            obtener=True
        )

        if filas is not None:
            total = filas[0][0] or 0
            etiqueta_total.config(
                text=f"${float(total):,.2f}"
            )

    def actualizar_ventas():
        cargar_ventas()
        calcular_total()

    def buscar_producto():
        codigo = cajas["codigo"].get().strip()

        if not codigo.isdigit():
            messagebox.showwarning("Aviso", "Ingresa un código válido.")
            return

        filas = ejecutar_consulta(
            """
            SELECT PRO_CODIGO, PRO_PRODUC, PRO_PRECIO
            FROM existencias
            WHERE PRO_CODIGO=%s
            """,
            (int(codigo),),
            obtener=True
        )

        if filas:
            cajas["nombre"].delete(0, tk.END)
            cajas["precio"].delete(0, tk.END)

            cajas["nombre"].insert(0, str(filas[0][1]))
            cajas["precio"].insert(0, str(filas[0][2]))
        else:
            messagebox.showinfo("Aviso", "Producto no encontrado.")

    def vender():
        correcto = realizar_venta(
            cajas["codigo"].get().strip(),
            cajas["cantidad"].get().strip()
        )

        if correcto:
            limpiar()
            actualizar_ventas()
    def generar_PDF():
        # Crear archivo PDF
        pdf = canvas.Canvas("reporte_pro.pdf")
        # Agregar título
        pdf.setFont("Helvetica-Bold", 16)
        pdf.drawString(150, 750, "REPORTE DE PRODUCTOS")
        # Agregar encabezados
        pdf.setFont("Helvetica-Bold", 10)
        pdf.drawString(50, 700, "VENTA")
        pdf.drawString(100, 700, "CODIGO")
        pdf.drawString(150, 700, "PRODUCTO")
        pdf.drawString(200, 700, "PRECIO")
        pdf.drawString(250, 700, "CANTIDAD")
        pdf.drawString(300, 700, "TOTAL")
        pdf.drawString(350, 700, "FECHA")
        
        # Obtener datos del Treeview
        y = 670
        for fila in tabla.get_children():
            valores = tabla.item(fila)["values"]
            pdf.setFont("Helvetica", 10)
            pdf.drawString(50, y, str(valores[0]))
            pdf.drawString(100, y, str(valores[1]))
            pdf.drawString(150, y, str(valores[2]))
            pdf.drawString(100, y, str(valores[3]))
            pdf.drawString(250, y, str(valores[4]))
            pdf.drawString(300, y, str(valores[5]))
