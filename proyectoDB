def generar_ticket(numero, nombre, codigo, precio, cantidad, total):

    fecha = datetime.now().strftime("%d/%m/%Y")
    hora = datetime.now().strftime("%H:%M:%S")

    ticket = f"""
================================
           PAPELERIA
================================

         TICKET DE VENTA

Venta No.: {numero}

Fecha: {fecha}
Hora: {hora}

--------------------------------
Codigo:       {codigo}
Producto:     {nombre}
Precio:       ${float(precio):.2f}
Cantidad:     {cantidad}
--------------------------------

TOTAL A PAGAR: ${float(total):.2f}

================================
       ¡GRACIAS POR SU COMPRA!
================================

          Vuelva pronto :)
"""

    ventana_ticket = tk.Toplevel(marco_contenido.winfo_toplevel())
    ventana_ticket.title("Ticket de venta")
    ventana_ticket.geometry("430x570")
    ventana_ticket.configure(bg="#F3E8FF")
    ventana_ticket.resizable(False, False)

    ventana_ticket.transient(marco_contenido.winfo_toplevel())

    tk.Label(
        ventana_ticket,
        text="VENTA REALIZADA",
        font=("Arial", 19, "bold"),
        bg="#F3E8FF",
        fg="#674188"
    ).pack(pady=12)

    marco_ticket = tk.Frame(
        ventana_ticket,
        bg="white",
        bd=2,
        relief="solid"
    )
    marco_ticket.pack(padx=25, pady=5, fill="both", expand=True)

    texto_ticket = tk.Text(
        marco_ticket,
        font=("Courier New", 10),
        bg="white",
        fg="#333333",
        relief="flat",
        padx=15,
        pady=15,
        wrap="none"
    )
    texto_ticket.pack(fill="both", expand=True)

    texto_ticket.insert("1.0", ticket)
    texto_ticket.config(state="disabled")

    def guardar_ticket():
        archivo = filedialog.asksaveasfilename(
            parent=ventana_ticket,
            title="Guardar ticket",
            defaultextension=".txt",
            filetypes=[("Archivo de texto", "*.txt")],
            initialfile=f"Ticket_Venta_{numero}.txt"
        )

        if archivo:
            with open(archivo, "w", encoding="utf-8") as f:
                f.write(ticket)

            messagebox.showinfo(
                "Éxito",
                "Ticket guardado correctamente.",
                parent=ventana_ticket
            )

    def imprimir_ticket():
        archivo = filedialog.asksaveasfilename(
            parent=ventana_ticket,
            title="Guardar ticket para imprimir",
            defaultextension=".txt",
            filetypes=[("Archivo de texto", "*.txt")],
            initialfile=f"Ticket_Venta_{numero}.txt"
        )

        if archivo:
            with open(archivo, "w", encoding="utf-8") as f:
                f.write(ticket)

            try:
                if os.name == "nt":
                    os.startfile(archivo, "print")
                    messagebox.showinfo(
                        "Imprimir",
                        "Se envió el ticket a la impresora.",
                        parent=ventana_ticket
                    )
                else:
                    messagebox.showinfo(
                        "Ticket guardado",
                        "Abre el archivo guardado para imprimirlo.",
                        parent=ventana_ticket
                    )

            except Exception as e:
                messagebox.showerror(
                    "Error",
                    f"No se pudo imprimir: {e}",
                    parent=ventana_ticket
                )

    botones = tk.Frame(
        ventana_ticket,
        bg="#F3E8FF"
    )
    botones.pack(pady=12)

    tk.Button(
        botones,
        text="GUARDAR",
