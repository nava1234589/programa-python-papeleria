    tk.Button(
        botones,
        text="IMPRIMIR",
        command=imprimir_ticket,
        bg="#9F73AB",
        fg="white",
        width=13,
        height=2,
        font=("Arial", 10, "bold")
    ).pack(side="left", padx=5)

    tk.Button(
        botones,
        text="CERRAR",
        command=ventana_ticket.destroy,
        bg="#512B81",
        fg="white",
        width=13,
        height=2,
        font=("Arial", 10, "bold")
    ).pack(side="left", padx=5)
def realizar_venta(codigo, cantidad):

    if not codigo.isdigit() or not cantidad.isdigit() or int(cantidad) <= 0:
        messagebox.showwarning("Aviso", "Código o cantidad inválidos.")
        return False

    con = conectar()

    if con is None:
        return False

    cursor = None

    try:
        cursor = con.cursor()

        cursor.execute(
            """
            SELECT PRO_PRODUC, PRO_PRECIO, PRO_STOCK
            FROM existencias
            WHERE PRO_CODIGO=%s
            """,
            (int(codigo),)
        )

        producto = cursor.fetchone()

        if producto is None:
            messagebox.showwarning("Aviso", "Producto no encontrado.")
            return False

        nombre, precio, stock = producto
        cantidad = int(cantidad)

        if stock < cantidad:
            messagebox.showwarning(
                "Stock insuficiente",
                f"Stock disponible: {stock}"
            )
            return False

        total = float(precio) * cantidad

        cursor.execute(
            """
            INSERT INTO ventas
            (pro_codigo, pro_nombre, pro_precio,
             pro_cantidad, pro_total)
            VALUES (%s,%s,%s,%s,%s)
            """,
            (int(codigo), nombre, precio, cantidad, total)
        )

        numero_venta = cursor.lastrowid

        cursor.execute(
            """
            UPDATE existencias
            SET pro_stock = pro_stock - %s
            WHERE pro_codigo = %s
            """,
            (cantidad, int(codigo))
        )

        con.commit()

        generar_ticket(
            numero_venta, nombre, codigo,
            precio, cantidad, total
        )

        messagebox.showinfo(
            "Venta exitosa",
            f"Producto: {nombre}\n"
            f"Cantidad: {cantidad}\n"
            f"TOTAL: ${total:.2f}"
        )

        return True

    except mysql.connector.Error as e:
        con.rollback()
        messagebox.showerror("Error de venta", str(e))
        return False

    finally:
        if cursor:
            cursor.close()
        con.close()


