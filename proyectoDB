    botones.pack(pady=10)

    acciones = [
        ("Vender", vender),
        ("Buscar", buscar_producto),
        ("Mostrar", actualizar_ventas),
        ("Limpiar", limpiar),
        ("Reporte PDF", generar_PDF)
    ]

    for texto, funcion in acciones:
        color = "#28A745" if texto == "Vender" else "#674188"

        tk.Button(
            botones,
            text=texto,
            width=13,
            command=funcion,
            bg=color,
            fg="white",
            font=("Arial", 9, "bold")
        ).pack(side="left", padx=5)

    actualizar_ventas()
 

def mostrar_catalogo():
    limpiar_contenido()
    marco_contenido
    titulo = tk.Label(
        marco_contenido,
        text="CATÁLOGO DE PRODUCTOS",
        font=("Arial", 18, "bold"),
        bg="#F3E8FF",
        fg="#512B81"
    )
    titulo.pack(pady=10)

    ruta = os.path.join(
        os.path.dirname(os.path.abspath(__file__)),
        "catalogo_productos_papeleria_codigos_numericos.pdf"
    )

    if not os.path.exists(ruta):
        messagebox.showerror("Error", "No se encontró el PDF")
        return

    documento = fitz.open(ruta)

    lienzo = tk.Canvas(marco_contenido, bg="white")
    lienzo.pack(side="left", fill="both", expand=True)

    barra = ttk.Scrollbar(
        marco_contenido,
        orient="vertical",
        command=lienzo.yview
    )
    barra.pack(side="right", fill="y")

    lienzo.configure(yscrollcommand=barra.set)

    marco = tk.Frame(lienzo, bg="white")
    lienzo.create_window((0, 0), window=marco, anchor="nw")

    imagenes = []

    for pagina in documento:
        pix = pagina.get_pixmap(matrix=fitz.Matrix(1.2, 1.2))
        imagen = Image.frombytes(
            "RGB",
            [pix.width, pix.height],
            pix.samples
        )

        foto = ImageTk.PhotoImage(imagen)
        imagenes.append(foto)

        etiqueta = tk.Label(marco, image=foto, bg="white")
        etiqueta.pack(pady=8)

    marco.update_idletasks()
    lienzo.configure(scrollregion=lienzo.bbox("all"))

    lienzo.imagenes = imagenes
    lienzo.documento = documento
