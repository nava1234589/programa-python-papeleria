def conectar():
    try:
        return mysql.connector.connect(
            host="localhost",
            user="root",
            passwd="",
            database="negocio"
        )
    except mysql.connector.Error as e:
        messagebox.showerror("Error de conexión", str(e))
        return None


def ejecutar_consulta(sql, parametros=(), obtener=False):
    con = conectar()
    if con is None:
        return None

    cursor = None
    try:
        cursor = con.cursor()
        cursor.execute(sql, parametros)

        if obtener:
            return cursor.fetchall()

        con.commit()
        return cursor.rowcount

    except mysql.connector.Error as e:
        messagebox.showerror("Error MySQL", str(e))
        return None

    finally:
        if cursor:
            cursor.close()
        con.close()


