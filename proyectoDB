        pdf.save()
        # Abrir archivo
        os.startfile("reporte_pro.pdf")
    tabla.bind(
        "<<TreeviewSelect>>",
        lambda event: seleccionar_venta(event)
    )

    def seleccionar_venta(event=None):
        seleccion = tabla.selection()
        if not seleccion:
            return

        valores = tabla.item(seleccion[0], "values")

        for clave, valor in zip(
            ["codigo", "nombre", "precio", "cantidad"],
            [valores[1], valores[2], valores[3], valores[4]]
        ):
