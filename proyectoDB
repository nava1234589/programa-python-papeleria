def mostrar_productos():
    def cargar_catalogo():
        if not messagebox.askyesno(
            "Confirmar",
            "¿Deseas cargar los 99 productos del catálogo?"
        ):
            return

        con = conectar()

        if con is None:
            return

        cursor = None

        try:
            cursor = con.cursor()
            agregados = 0

            for codigo, (nombre, precio) in enumerate(CATALOGO, start=1):

                # Revisar si ya existe en productos
                cursor.execute(
                    "SELECT pro_codigo FROM producto WHERE pro_codigo=%s",
                    (codigo,)
                )

                existe = cursor.fetchone()

                if not existe:
                    cursor.execute(
                        """
                        INSERT INTO producto
                        (pro_codigo, pro_nombre, pro_descripcion,
                         pro_costo, pro_precio, pro_categoria)
                        VALUES (%s, %s, %s, %s, %s, %s)
                        """,
                        (codigo, nombre, nombre, 0, precio, "Papelería")
                    )
                    agregados += 1

                # Revisar si ya existe en inventario
                cursor.execute("""
                    INSERT INTO existencias
                    (PRO_CODIGO, PRO_PRODUC, PRO_PRECIO, PRO_STOCK)
                    VALUES (%s, %s, %s, %s)
                """, (codigo, nombre, precio, 15))

                existe_inventario = cursor.fetchone()

                if not existe_inventario:
                    cursor.execute(
                        """
                        INSERT INTO existencias
                        (PRO_CODIGO, PRO_PRODUC, PRO_PRECIO, PRO_STOCK)
                        VALUES (%s, %s, %s, %s)
                        """,
                        (codigo, nombre, precio, 0)
                    )

            con.commit()

            messagebox.showinfo(
                "Catálogo cargado",
                f"Se agregaron {agregados} productos nuevos.\n"
                "El inventario también fue actualizado."
            )

            cargar_productos()

        except mysql.connector.Error as e:
            con.rollback()
            messagebox.showerror("Error", str(e))

        finally:
            if cursor:
                cursor.close()
            con.close()
    limpiar_contenido()
    marco_contenido.configure(bg="#F3E8FF")
    crear_titulo(marco_contenido, "GESTIÓN DE PRODUCTOS")

    formulario = tk.Frame(marco_contenido, bg="#F3E8FF")
    formulario.pack(fill="x", padx=30)

    campos = [
        ("Código", "codigo"),
        ("Nombre", "nombre"),
        ("Descripción", "descripcion"),
        ("Costo de compra", "costo"),
        ("Precio de venta", "precio"),
        ("Categoría", "categoria")
    ]

    cajas = {}

    for i, (texto, clave) in enumerate(campos):
        columna = 0 if i < 3 else 2
        fila = i if i < 3 else i - 3

        tk.Label(
            formulario,
            text=texto,
            bg="#F3E8FF",
            fg="#512B81",
            font=("Arial", 10, "bold")
        ).grid(row=fila, column=columna, padx=10, pady=10)

        caja = tk.Entry(formulario, width=25)
        caja.grid(row=fila, column=columna + 1, padx=10, pady=10)
        cajas[clave] = caja

    tabla = ttk.Treeview(
        marco_contenido,
        columns=("codigo", "nombre", "descripcion",
                 "costo", "precio", "categoria"),
        show="headings",
        height=12
    )

    encabezados = [
        ("codigo", "CÓDIGO", 70),
        ("nombre", "NOMBRE", 150),
        ("descripcion", "DESCRIPCIÓN", 200),
        ("costo", "COSTO", 100),
        ("precio", "PRECIO", 100),
        ("categoria", "CATEGORÍA", 130)
    ]

    for columna, titulo, ancho in encabezados:
        tabla.heading(columna, text=titulo)
        tabla.column(columna, width=ancho, anchor="center")

    tabla.pack(fill="x", padx=30, pady=15)

    def limpiar():
        for caja in cajas.values():
            caja.delete(0, tk.END)

    def cargar_productos():
        tabla.delete(*tabla.get_children())

        filas = ejecutar_consulta(
            """
            SELECT pro_codigo, pro_nombre, pro_descripcion,
                   pro_costo, pro_precio, pro_categoria
            FROM producto
            ORDER BY pro_codigo
            """,
            obtener=True
        )

        if filas is not None:
            for fila in filas:
                tabla.insert("", tk.END, values=fila)

    def registrar():
        nombre = cajas["nombre"].get().strip()
        descripcion = cajas["descripcion"].get().strip()
        costo = cajas["costo"].get().strip()
        precio = cajas["precio"].get().strip()
        categoria = cajas["categoria"].get().strip()

        if not all([nombre, descripcion, costo, precio, categoria]):
            messagebox.showwarning("Aviso", "Completa todos los campos.")
            return

        try:
            costo = int(costo)
            precio = int(precio)

            if costo < 0 or precio < 0:
                raise ValueError

        except ValueError:
            messagebox.showwarning("Aviso", "Precios inválidos.")
            return

        resultado = ejecutar_consulta(
            """
            INSERT INTO producto
            (pro_nombre, pro_descripcion, pro_costo,
            pro_precio, pro_categoria)
            VALUES (%s, %s, %s, %s, %s)
            """,
            (nombre, descripcion, costo, precio, categoria)
        )

        if resultado is not None:
            messagebox.showinfo("Éxito", "Producto registrado.")
            limpiar()
            cargar_productos()
    def buscar():
        codigo = cajas["codigo"].get().strip()

        if not codigo.isdigit():
            messagebox.showwarning("Aviso", "Ingresa un código válido.")
            return

        filas = ejecutar_consulta(
            """
            SELECT pro_codigo, pro_nombre, pro_descripcion,
                   pro_costo, pro_precio, pro_categoria
            FROM producto
            WHERE pro_codigo=%s
            """,
            (int(codigo),),
            obtener=True
        )

        tabla.delete(*tabla.get_children())

        if filas is not None:
            for fila in filas:
                tabla.insert("", tk.END, values=fila)

            if filas:
                seleccionar_valores(filas[0])
            else:
                messagebox.showinfo("Aviso", "Producto no encontrado.")

    def seleccionar_valores(valores):
        limpiar()
        for clave, valor in zip(
            ["codigo", "nombre", "descripcion",
             "costo", "precio", "categoria"],
            valores
        ):
            cajas[clave].insert(0, str(valor))

    def actualizar():
        codigo = cajas["codigo"].get().strip()
        nombre = cajas["nombre"].get().strip()
        descripcion = cajas["descripcion"].get().strip()
        costo = cajas["costo"].get().strip()
        precio = cajas["precio"].get().strip()
        categoria = cajas["categoria"].get().strip()

        if not codigo.isdigit() or not all([
            nombre, descripcion, costo, precio, categoria
        ]):
            messagebox.showwarning("Aviso", "Completa todos los campos.")
            return

        try:
            costo = float(costo)
            precio = float(precio)
            if costo < 0 or precio < 0:
                raise ValueError
        except ValueError:
            messagebox.showwarning("Aviso", "Precios no válidos.")
            return

        resultado = ejecutar_consulta(
            """
            UPDATE producto
            SET pro_nombre=%s, pro_descripcion=%s,
                pro_costo=%s, pro_precio=%s, pro_categoria=%s
            WHERE pro_codigo=%s
            """,
            (nombre, descripcion, costo, precio, categoria, int(codigo))
        )

        if resultado is not None:
            messagebox.showinfo("Éxito", "Producto actualizado.")
            cargar_productos()

    def eliminar():
        codigo = cajas["codigo"].get().strip()

        if not codigo.isdigit():
            messagebox.showwarning("Aviso", "Ingresa un código válido.")
            return

        if not messagebox.askyesno("Confirmar", "¿Eliminar producto?"):
            return

        resultado = ejecutar_consulta(
            "DELETE FROM producto WHERE pro_codigo=%s",
            (int(codigo),)
        )

        if resultado is not None:
            messagebox.showinfo("Resultado", "Operación realizada.")
            limpiar()
            cargar_productos()
    def seleccionar_fila(event):
        seleccion = tabla.selection()

        if seleccion:
            fila = tabla.item(seleccion[0], "values")

            cajas["nombre"].delete(0, tk.END)
            cajas["nombre"].insert(0, fila[1])

            cajas["descripcion"].delete(0, tk.END)
            cajas["descripcion"].insert(0, fila[2])

            cajas["costo"].delete(0, tk.END)
            cajas["costo"].insert(0, fila[3])

            cajas["precio"].delete(0, tk.END)
            cajas["precio"].insert(0, fila[4])

            cajas["categoria"].delete(0, tk.END)
            cajas["categoria"].insert(0, fila[5])
        tabla.bind("<<TreeviewSelect>>", seleccionar_fila)

    botones = tk.Frame(marco_contenido, bg="#F3E8FF")
    botones.pack(pady=10)

    for texto, funcion in [
        ("Registrar", registrar),
        ("Mostrar", cargar_productos),
        ("Buscar", buscar),
        ("Actualizar", actualizar),
        ("Eliminar", eliminar),
        ("Limpiar", limpiar),
        ("Cargar catálogo", cargar_catalogo)
    ]:
        tk.Button(
            botones, text=texto, width=12,
            command=funcion, bg="#674188", fg="white"
        ).pack(side="left", padx=5)

    cargar_productos()


